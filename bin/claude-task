#!/usr/bin/env bash
#
# claude-task - Claude session をまたぐタスク管理 (/kidou で積む・起動する、/bankai で把握・振り分ける)
#
# 状態の正は ~/.claude/plans/.tasks/<id>.json。書き込みはこのスクリプト経由のみ (スキーマと状態遷移を固定する)。
# session の生死・返事待ち・ブロック中は保存せず、表示のたびに session registry とタスク間依存から導出する。
# 設計: dotfiles/claude/docs/task-system-design.md
#
# Usage:
#   claude-task add [--type T] [--parent T-n] [--dir D] [--priority 1-4] [--customer C] [--summary S]
#                   [--blocked-by T-1,T-2] [--waiting-on W] [--body TEXT] <title...>
#                                    type (既定 work。成果物と完了条件で分ける):
#                                      analysis 分析  成果物は結論 (問題なし / issue / Slack)。worktree を切らない。done には結論が必須
#                                      work     作業  成果物は PR / issue / Slack 報告 (自分がするレビューも含む)。worktree を切る
#                                      request  依頼  他者に作業・回答・レビューを依頼して待つ。--waiting-on (相手・URL) で waiting になる
#                                      epic     epic  ユースケースごとの親。子 (--parent で指す) の完了が成果。子が残っていると done できない
#                                    parent: 所属 epic (1 段のみ)。epic 内の順序は blocked_by で表す。子の一覧は保存せず導出する
#                                    customer: お客さん名。プロダクト全体の作業は「全体」、未確認なら空 (Slack では「未確認」)
#                                    summary: 機能単位の概要。epic に属さないタスクだけ Slack 報告の段落になる (epic の子は epic 単位)。空なら title
#                                    priority (既定 4):
#                                      1 復旧   アラート・脆弱性・e2e/CI などテスト復旧 (プロダクト継続に問題がある作業)
#                                      2 優先   問い合わせ対応・レビュー確認など (待っている人がいる作業)
#                                      3 目標   月目標・顧客約束を含む、戦略的にやるべき作業
#                                      4 その他 約束しておらず今ではない。着手するなら目標への格上げ調整が先 (自動起動しない)
#                                    タスクを追加し ID を出力。--waiting-on ありなら waiting、dir 指定ありなら queued、無しなら inbox
#   claude-task ls [--all] [--json|--table|--slack]
#                                    状態別に一覧 (返事待ち/実行中/要確認/依頼中/起動可能/ブロック中/inbox/タスク外 session)
#                                    --table は Markdown 表 (タスク / 優先度 / 種別 / session / 概要 / 状態)。/kidou・/bankai の実行後表示用
#                                    --slack は Slack 報告用 mrkdwn (優先度ごとの見出し + epic (無ければ概要) ごとの段落「お客さん名: 概要」。
#                                    番号・session・状態は出さず、段落内のタスクは依存順に並べる)
#   claude-task tree [<epic>]        epic の子を依存順の木で表示 (省略時は未完了の全 epic)
#   claude-task show <id>            タスクの JSON を表示
#   claude-task set <id> key=value.. 変更可能キー: title type parent dir priority customer summary body blocked_by prs result
#                                    waiting_on plan_topic status
#                                    (body は起動時の最初のプロンプト。変更すると log に記録する)
#                                    (blocked_by/prs はカンマ区切り。inbox に dir を入れると queued になる。waiting_on を入れると waiting になる)
#   claude-task log <id> <msg...>    ログ追記
#   claude-task link <id> <session_id> [session_name]
#                                    session と紐付けて running にする (SessionStart hook が呼ぶ)
#   claude-task adopt <session名|session_id> [title...]
#                                    タスク外の live session を running タスクとして取り込む
#   claude-task done <id> [result...] / drop <id>
#                                    完了 / 取り下げ。result を渡すと記録する (analysis は result 必須、epic は子が残っていると拒否)。
#                                    直後に起動可能になったタスクと done 候補の epic を表示し、タスクの repo ルートで
#                                    delete_git_merged_branch.sh を実行して merge 済み branch と worktree を片付ける
#                                    (cwd が worktree 内なら実行せず案内のみ)
#   claude-task launch-spec <id>     起動仕様を JSON で出力 {id, dir, worktree, prompt}。dir は本体 repo のルート、
#                                    work は prompt に「起動後に EnterWorktree (name: task-<n>) で worktree を切る」指示を埋め込む
#                                    (work 以外と git 外の dir では worktree 指示なし)。/kidou <n> (内部で /delegate task:) はこれをそのまま使う
#   claude-task brief <id>           担当 session に注入する 1 行 (種別ごとの完了手順と親 epic)。SessionStart hook が使う
#   claude-task id-of-session <session_id>
#                                    session に紐付くタスク ID を出力 (無ければ空)

# jq フィルタ内の $var は jq 変数 (shell 展開させない) ため SC2016 は誤検知
# shellcheck disable=SC2016

set -euo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
TASKS_DIR="$CLAUDE_DIR/plans/.tasks"
SESSIONS_DIR="$CLAUDE_DIR/sessions"
LOCAL_MD="$CLAUDE_DIR/CLAUDE.local.md"
SEQ_FILE="$TASKS_DIR/.seq"
LOCK_DIR="$TASKS_DIR/.lock"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

mkdir -p "$TASKS_DIR"

die() { echo "claude-task: $*" >&2; exit 1; }
now() { date +%Y-%m-%dT%H:%M:%S%z; }

# ---------------------------------------------------------------------------
# 書き込みロック (mkdir はアトミック)。古いロック (60秒超) は残骸とみなして奪う
# ---------------------------------------------------------------------------
lock() {
  local i=0
  until mkdir "$LOCK_DIR" 2>/dev/null; do
    if find "$LOCK_DIR" -maxdepth 0 -mmin +1 -print -quit 2>/dev/null | grep -q .; then
      rmdir "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
    i=$((i + 1))
    [ "$i" -gt 100 ] && die "ロックを取得できません: $LOCK_DIR"
    sleep 0.1
  done
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
}

task_file() { echo "$TASKS_DIR/$1.json"; }

require_task() {
  [[ "$1" =~ ^T-[0-9]+$ ]] || die "不正なタスク ID: $1"
  [ -f "$(task_file "$1")" ] || die "タスクが存在しません: $1"
}

# jq フィルタを適用してアトミックに書き戻す (呼び出し側でロック済みであること)
update_task() {
  local id="$1" filter="$2"; shift 2
  local f tmp
  f=$(task_file "$id")
  tmp="$f.tmp.$$"
  jq "$@" --arg now "$(now)" "$filter | .updated = \$now" "$f" >"$tmp"
  mv "$tmp" "$f"
}

caller_tag() {
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then echo " (from session ${CLAUDE_CODE_SESSION_ID:0:8})"; fi
}

# title は /bankai の報告でタスクを呼ぶ名前。日本語 10-30 字の目安を外れたら警告だけ出す
# (adopt の仮タイトルは session 名になるため拒否はしない)
warn_title() {
  local n
  n=$(jq -rn --arg t "$1" '$t | length')
  if [ "$n" -lt 10 ] || [ "$n" -gt 30 ]; then
    echo "claude-task: warning: title は 10-30 字が目安です (${n} 字): $1" >&2
  fi
}

csv_to_json() {
  jq -nc --arg s "$1" '$s | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))'
}

TYPES="analysis work request epic"

# 種別追加前のタスクは type / parent / result / waiting_on を持たないため、読むときに既定値で補う (ファイルは書き換えない)
JQ_NORM='def norm: . + {type: (.type // "work"), parent: (.parent // ""), result: (.result // ""), waiting_on: (.waiting_on // "")};'

task_field() { jq -r "$JQ_NORM"' norm | .'"$2" "$(task_file "$1")"; }

check_type() {
  [[ " $TYPES " == *" $1 "* ]] || die "type は $TYPES のいずれか (analysis 分析 / work 作業 / request 依頼 / epic)"
}

# parent は epic に限り、epic 自身は parent を持てない (1 段のみ)
check_parent() {
  local id="$1" type="$2" parent="$3"
  [ -n "$parent" ] || return 0
  require_task "$parent"
  [ "$parent" != "$id" ] || die "自分自身を parent にはできません"
  [ "$(task_field "$parent" type)" = epic ] || die "parent は epic のみ: $parent は $(task_field "$parent" type)"
  [ "$type" != epic ] || die "epic は parent を持てません (epic は 1 段のみ)"
}

# 指定 epic を parent に持つタスク (done / dropped を含む)
children_of() {
  all_tasks_json | jq -r --arg p "$1" "$JQ_NORM"'.[] | norm | select(.parent == $p) | .id'
}

# ---------------------------------------------------------------------------
# 表示時の導出に使う入力
# ---------------------------------------------------------------------------
all_tasks_json() {
  local files=("$TASKS_DIR"/T-*.json)
  if [ -e "${files[0]}" ]; then jq -s '.' "${files[@]}"; else echo '[]'; fi
}

live_sessions_json() {
  local files=("$SESSIONS_DIR"/*.json)
  if [ -e "${files[0]}" ]; then
    jq -s '[.[] | select(.sessionId != null) | {sessionId, name: (.name // ""), cwd: (.cwd // ""), status: (.status // "?"), pid}]' "${files[@]}" 2>/dev/null || echo '[]'
  else
    echo '[]'
  fi
}

# CLAUDE.local.md の Plan Group mapping ("- <pattern>: <group>") を [{pattern, group}] に
group_map_json() {
  if [ -f "$LOCAL_MD" ]; then
    sed -n 's/^- \([^:[:space:]][^:]*\): \([A-Za-z0-9_-][A-Za-z0-9_-]*\)$/\1\t\2/p' "$LOCAL_MD" |
      jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | {pattern: .[0], group: .[1]})'
  else
    echo '[]'
  fi
}

# 保存時はホームを ~ に畳む (フルパスにユーザー名を残さない。表示・比較も ~ 形式で揃う)
fold_home() {
  case "$1" in
    "$HOME") echo "~" ;;
    "$HOME"/*) echo "~${1#"$HOME"}" ;;
    *) echo "$1" ;;
  esac
}

expand_dir() {
  case "$1" in
    \~) echo "$HOME" ;;
    \~/*) echo "$HOME/${1#\~/}" ;;
    *) echo "$1" ;;
  esac
}

# dir → 本体 repo のルート (git 外なら空)。worktree の中でも本体側を返すよう、git-common-dir が "<repo>/.git" ならその親を使う。
# submodule は git-common-dir が "<super>/.git/modules/<name>" になるため toplevel に落とす
repo_root_of_dir() {
  local d common
  d=$(expand_dir "$1")
  common=$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  if [[ "$common" == */.git ]]; then
    dirname "$common"
    return 0
  fi
  # submodule: 本体側のチェックアウト位置は common dir の core.worktree (common dir からの相対) にある。
  # submodule 内の worktree で toplevel を使うと worktree 自身を返してしまうため、こちらを優先する
  local wt
  wt=$(git --git-dir="$common" config core.worktree 2>/dev/null || true)
  if [ -n "$wt" ] && (cd "$common" && cd "$wt" 2>/dev/null); then
    (cd "$common" && cd "$wt" && pwd -P)
  else
    git -C "$d" rev-parse --show-toplevel
  fi
}

repo_of_dir() {
  local root
  root=$(repo_root_of_dir "$1")
  basename "${root:-$(expand_dir "$1")}"
}

# タスクと live session の全 dir について {dir: repo} を作る
repo_map_json() {
  local tasks="$1" live="$2" d out='{}'
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    out=$(jq -c --arg d "$d" --arg r "$(repo_of_dir "$d")" '. + {($d): $r}' <<<"$out")
  done < <(jq -rn --argjson t "$tasks" --argjson l "$live" '([$t[].dir] + [$l[].cwd]) | unique | .[]')
  echo "$out"
}

# 全タスクに live / blocked / repo / group を付けた配列と、タスク外 session を返す
#   {tasks: [...], untracked: [...]}
enriched_json() {
  local tasks live gmap rmap
  tasks=$(all_tasks_json)
  live=$(live_sessions_json)
  gmap=$(group_map_json)
  rmap=$(repo_map_json "$tasks" "$live")
  jq -n --argjson tasks "$tasks" --argjson live "$live" --argjson gmap "$gmap" --argjson rmap "$rmap" \
    --arg home "$HOME" --arg self "${CLAUDE_CODE_SESSION_ID:-}" "$JQ_NORM"'
    def expand: if startswith("~/") then $home + .[1:] elif . == "~" then $home else . end;
    def group_of: (expand) as $d
      | [$gmap[] | . as $m | select(($d | endswith("/" + $m.pattern)) or ($d | contains("/" + $m.pattern + "/")))]
      | sort_by(.pattern | length) | last | (.group // "");
    ($tasks | map(norm)) as $tasks
    | ($tasks | map({key: .id, value: .status}) | from_entries) as $st
    | ($tasks | map(select(.session_id != "") | .session_id)) as $linked
    | ($tasks | map(
        . as $t
        | ([$live[] | select(.sessionId == $t.session_id)] | first) as $s
        | ([$tasks[] | select(.parent == $t.id) | .id]) as $kids
        | . + {
            live: (if $t.session_id == "" then "" elif $s then $s.status else "exited" end),
            blocking: [$t.blocked_by[] | select(($st[.] // "missing") as $x | $x != "done" and $x != "dropped")],
            # epic の子 (保存せず parent から導出)。kids_open は未完了の子
            kids: $kids,
            kids_open: [$kids[] | select($st[.] != "done" and $st[.] != "dropped")],
            repo: (if $t.dir == "" then "" else ($rmap[$t.dir] // "") end),
            group: (if $t.dir == "" then "" else ($t.dir | group_of) end)
          }
      )) as $all
    | {
        tasks: $all,
        untracked: [$live[] | select(.sessionId as $i | ($linked | index($i)) == null and $i != $self)
                    | . + {repo: ($rmap[.cwd] // ""), group: (.cwd | group_of)}]
      }'
}

# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------
cmd_add() {
  local dir="" priority=4 blocked="" body="" customer="" summary="" type=work parent="" waiting_on="" title
  while [ $# -gt 0 ]; do
    case "$1" in
      --type) type="$2"; shift 2 ;;
      --parent) parent="$2"; shift 2 ;;
      --waiting-on) waiting_on="$2"; shift 2 ;;
      --dir) dir="$2"; shift 2 ;;
      --priority) priority="$2"; shift 2 ;;
      --blocked-by) blocked="$2"; shift 2 ;;
      --body) body="$2"; shift 2 ;;
      --customer) customer="$2"; shift 2 ;;
      --summary) summary="$2"; shift 2 ;;
      --) shift; break ;;
      -*) die "add: 不明なオプション $1" ;;
      *) break ;;
    esac
  done
  title="$*"
  [ -n "$title" ] || die "add: title が必要です"
  warn_title "$title"
  [[ "$priority" =~ ^[1-4]$ ]] || die "add: priority は 1-4 (1 復旧 / 2 優先 / 3 目標 / 4 その他)"
  check_type "$type"
  check_parent "" "$type" "$parent"
  [ -n "$body" ] || body="$title"
  if [ -n "$dir" ]; then
    [ -d "$(expand_dir "$dir")" ] || die "add: dir が存在しません: $dir"
    dir=$(fold_home "${dir%/}")
  fi

  local blocked_json b
  blocked_json=$(csv_to_json "$blocked")
  for b in $(jq -r '.[]' <<<"$blocked_json"); do require_task "$b"; done

  lock
  local seq id status
  seq=$(( $(cat "$SEQ_FILE" 2>/dev/null || echo 0) + 1 ))
  echo "$seq" >"$SEQ_FILE"
  id="T-$seq"
  if [ -n "$waiting_on" ]; then status=waiting
  elif [ -n "$dir" ]; then status=queued
  else status=inbox; fi
  jq -n --arg id "$id" --arg title "$title" --arg status "$status" --arg dir "$dir" \
    --argjson priority "$priority" --argjson blocked "$blocked_json" --arg body "$body" \
    --arg customer "$customer" --arg summary "$summary" \
    --arg type "$type" --arg parent "$parent" --arg waiting_on "$waiting_on" \
    --arg now "$(now)" --arg msg "add$(caller_tag)" '{
      id: $id, type: $type, parent: $parent, title: $title, status: $status, dir: $dir, priority: $priority,
      customer: $customer, summary: $summary,
      blocked_by: $blocked, waiting_on: $waiting_on, result: "", session_name: "", session_id: "", prs: [], plan_topic: "",
      body: $body, log: [{at: $now, msg: $msg}], created: $now, updated: $now
    }' >"$(task_file "$id")"
  echo "$id"
}

STATUSES="inbox queued running waiting done dropped"

cmd_set() {
  local id="$1"; shift
  require_task "$id"
  [ $# -gt 0 ] || die "set: key=value が必要です"
  lock
  local kv key val
  for kv in "$@"; do
    [[ "$kv" == *=* ]] || die "set: key=value 形式ではありません: $kv"
    key="${kv%%=*}"; val="${kv#*=}"
    case "$key" in
      title)
        [ -n "$val" ] || die "set: title は空にできません"
        warn_title "$val"
        update_task "$id" '.log += [{at: $now, msg: ("title: " + .title + " -> " + $v)}] | .title = $v' --arg v "$val" ;;
      type)
        check_type "$val"
        if [ "$val" = epic ]; then
          [ -z "$(task_field "$id" parent)" ] || die "set: parent を持つタスクは epic にできません (先に parent= で外す)"
        elif [ -n "$(children_of "$id")" ]; then
          die "set: 子を持つ epic は種別を変えられません (子: $(children_of "$id" | paste -sd, -))"
        fi
        update_task "$id" '.log += [{at: $now, msg: ("type: " + (.type // "work") + " -> " + $v)}] | .type = $v' --arg v "$val" ;;
      parent)
        check_parent "$id" "$(task_field "$id" type)" "$val"
        update_task "$id" '.log += [{at: $now, msg: ("parent: " + (.parent // "") + " -> " + $v)}] | .parent = $v' --arg v "$val" ;;
      result)
        update_task "$id" '.result = $v | .log += [{at: $now, msg: ("result: " + $v)}]' --arg v "$val" ;;
      waiting_on)
        # 依頼を送ったら相手待ち (waiting) にする。空にしても status は戻さない (再開は status= で明示)
        update_task "$id" '
          .waiting_on = $v
          | if $v != "" and (.status != "done" and .status != "dropped") then .status = "waiting" else . end
          | .log += [{at: $now, msg: ("waiting_on: " + $v)}]' --arg v "$val" ;;
      plan_topic)
        update_task "$id" '.plan_topic = $v' --arg v "$val" ;;
      customer|summary)
        update_task "$id" ".$key = \$v" --arg v "$val" ;;
      body)
        [ -n "$val" ] || die "set: body は空にできません"
        update_task "$id" '.body = $v | .log += [{at: $now, msg: "body updated"}]' --arg v "$val" ;;
      dir)
        if [ -n "$val" ]; then
          [ -d "$(expand_dir "$val")" ] || die "set: dir が存在しません: $val"
          val=$(fold_home "${val%/}")
        fi
        update_task "$id" '.dir = $v | if .status == "inbox" and $v != "" then .status = "queued" else . end' --arg v "$val" ;;
      priority)
        [[ "$val" =~ ^[1-4]$ ]] || die "set: priority は 1-4 (1 復旧 / 2 優先 / 3 目標 / 4 その他)"
        update_task "$id" '.log += [{at: $now, msg: ("priority: " + (.priority | tostring) + " -> " + $v)}] | .priority = ($v | tonumber)' --arg v "$val" ;;
      blocked_by)
        local j b
        j=$(csv_to_json "$val")
        for b in $(jq -r '.[]' <<<"$j"); do
          [ "$b" != "$id" ] || die "set: 自分自身には依存できません"
          require_task "$b"
        done
        update_task "$id" '.blocked_by = $v' --argjson v "$j" ;;
      prs)
        update_task "$id" '.prs = $v' --argjson v "$(csv_to_json "$val")" ;;
      status)
        [[ " $STATUSES " == *" $val "* ]] || die "set: status は $STATUSES のいずれか"
        if [ "$val" = queued ] && [ "$(jq -r .dir "$(task_file "$id")")" = "" ]; then
          die "set: dir 未定のまま queued にはできません"
        fi
        update_task "$id" '.status = $v | .log += [{at: $now, msg: ("status -> " + $v)}]' --arg v "$val" ;;
      *) die "set: 変更できないキー: $key" ;;
    esac
  done
}

cmd_log() {
  local id="$1"; shift
  require_task "$id"
  [ $# -gt 0 ] || die "log: メッセージが必要です"
  lock
  update_task "$id" '.log += [{at: $now, msg: $m}]' --arg m "$*$(caller_tag)"
}

cmd_link() {
  local id="$1" sid="$2" name="${3:-}"
  require_task "$id"
  [ -n "$sid" ] || die "link: session_id が必要です"
  lock
  update_task "$id" '
    .session_id = $sid | .session_name = (if $name != "" then $name else .session_name end)
    | .status = (if .status == "done" or .status == "dropped" then .status else "running" end)
    | .log += [{at: $now, msg: ("link session " + $sid[0:8] + (if $name != "" then " (" + $name + ")" else "" end))}]
  ' --arg sid "$sid" --arg name "$name"
}

cmd_adopt() {
  local key="${1:-}"; shift || true
  [ -n "$key" ] || die "adopt: session 名か session_id が必要です"
  local s
  s=$(live_sessions_json | jq -c --arg k "$key" '[.[] | select(.name == $k or .sessionId == $k or (.sessionId | startswith($k)))] | first // empty')
  [ -n "$s" ] || die "adopt: live session が見つかりません: $key"
  local sid name cwd existing title id
  sid=$(jq -r .sessionId <<<"$s"); name=$(jq -r .name <<<"$s"); cwd=$(jq -r .cwd <<<"$s")
  existing=$(cmd_id_of_session "$sid")
  [ -z "$existing" ] || die "adopt: 既に $existing に紐付いています"
  title="${*:-${name:-session ${sid:0:8}}}"
  cwd=$(fold_home "$cwd")
  id=$(cmd_add --dir "$cwd" -- "$title")
  rmdir "$LOCK_DIR" 2>/dev/null || true
  cmd_link "$id" "$sid" "$name"
  echo "$id"
}

# /kidou <n> (内部で /delegate task:) が起動に使う決定的な仕様。起動 dir は常に本体 repo のルート (信頼済み dir で起動し、
# 信頼確認を増やさない)。worktree は起動後に子 session 自身が EnterWorktree で切るよう指示文に埋め込む
cmd_launch_spec() {
  local id="$1"
  require_task "$id"
  local t dir status type root wt prompt
  t=$(jq -c "$JQ_NORM norm" "$(task_file "$id")")
  dir=$(jq -r .dir <<<"$t"); status=$(jq -r .status <<<"$t"); type=$(jq -r .type <<<"$t")
  [ -n "$dir" ] || die "launch-spec: $id は dir 未定です (claude-task set $id dir=...)"
  case "$status" in done|dropped) die "launch-spec: $id は $status です" ;; esac
  root=$(repo_root_of_dir "$dir")
  wt=""
  if [ -n "$root" ] && [ "$type" != work ]; then
    # 分析・依頼・epic はコードを変えないため worktree を切らない (完了手順は SessionStart の brief が注入する)
    prompt="[$id] worktree は作らず、本体 repo のまま作業してください (種別 $type はコードを変更しないため)。"
    local prefix
    prefix=$(git -C "$(expand_dir "$dir")" rev-parse --show-prefix 2>/dev/null || true)
    if [ -n "$prefix" ]; then
      prompt+=" 対象は repo 内の ${prefix%/} です。"
    fi
  elif [ -n "$root" ]; then
    wt="task-${id#T-}"
    prompt="[$id] 作業を始める前に EnterWorktree (name: $wt) で worktree を作成し、以降はその中で作業してください。この worktree 作成は /kidou からの起動指示のため、Worktree Rule の /wt による確認は不要です。"
    # repo 内のサブディレクトリ (monorepo 等) は worktree 内の同じ相対パスを案内する。worktree 自体を指す dir でも正しく取れるよう show-prefix を使う
    local prefix
    prefix=$(git -C "$(expand_dir "$dir")" rev-parse --show-prefix 2>/dev/null || true)
    if [ -n "$prefix" ]; then
      prompt+=" 作業対象は repo 内の ${prefix%/} です (worktree 内の同じ相対パス)。"
    fi
  else
    root=$(expand_dir "$dir")
    prompt="[$id]"
  fi
  prompt+=$'\n\n'"$(jq -r .body <<<"$t")"
  jq -n --arg id "$id" --arg dir "$root" --arg wt "$wt" --arg prompt "$prompt" \
    '{id: $id, dir: $dir, worktree: $wt, prompt: $prompt}'
}

# 担当 session に注入する 1 行 (SessionStart hook が使う)。完了の仕方は種別で変わるため、文面を script で決める
cmd_brief() {
  local id="$1"
  require_task "$id"
  local type parent msg
  type=$(task_field "$id" type); parent=$(task_field "$id" parent)
  msg="Task: この session は ${id} ($(type_label "$type")) を担当 (\`claude-task show ${id}\`)。"
  case "$type" in
    analysis)
      msg+="コードは変更しない。結論が出たら \`claude-task done ${id} <問題なし|issue や Slack の URL>\` で閉じる。修正が要ると分かったら /kidou で作業タスクとして積む" ;;
    request)
      msg+="依頼を送ったら \`claude-task set ${id} waiting_on=<相手・依頼先 URL>\`、返答を得たら \`claude-task done ${id} <返答の要旨か URL>\`" ;;
    epic)
      msg+="epic の親 session。\`claude-task tree ${id}\` で子と依存を把握し、子は \`/kidou parent: ${id} <依頼文>\` で積み、起動は \`/kidou <n>\` をユーザーに提案する (自分では実装しない)。子がすべて終わったら \`claude-task done ${id}\`" ;;
    *)
      msg+="PR を作ったら \`claude-task set ${id} prs=<owner/repo#N>\`、完了したら \`claude-task done ${id}\` (PR 以外の成果物は \`done ${id} <URL>\`)" ;;
  esac
  if [ -n "$parent" ]; then
    msg+="。親 epic: ${parent}「$(task_field "$parent" title)」(\`claude-task tree ${parent}\`)。派生タスクは \`/kidou parent: ${parent} ...\` で同じ epic に積む"
  fi
  echo "$msg"
}

type_label() {
  case "$1" in analysis) echo "分析" ;; request) echo "依頼" ;; epic) echo "epic" ;; *) echo "作業" ;; esac
}

cmd_id_of_session() {
  local sid="$1"
  all_tasks_json | jq -r --arg s "$sid" '[.[] | select(.session_id == $s)] | sort_by(.created) | last | .id // empty'
}

# 起動可能リスト (queued かつ未ブロック)。done / drop 後に新たに起動可能になったタスクの表示に使う
next_json() {
  enriched_json | jq '
    [.tasks[] | select(.status == "queued" and .type != "epic" and (.blocking | length) == 0)]
    | sort_by(.priority, .created)'
}

# done / drop 時の片付け。タスクの repo ルートで delete_git_merged_branch.sh を実行し、merge 済み branch と
# その worktree を消す (未 merge・変更ありの worktree は残る)。呼び出し元の cwd が worktree 内だと自分の cwd を
# 消してしまうため、その場合は実行せず ExitWorktree を促す
cleanup_merged() {
  local id="$1" dir root
  dir=$(jq -r .dir "$(task_file "$id")")
  [ -n "$dir" ] || return 0
  root=$(repo_root_of_dir "$dir")
  [ -n "$root" ] || return 0
  if [[ "$PWD" == */.claude/worktrees/* ]]; then
    echo "片付けは未実行 (cwd が worktree 内): ExitWorktree (action: keep) で抜けてから cd $(fold_home "$root") && delete_git_merged_branch.sh"
    return 0
  fi
  echo "片付け: $(fold_home "$root") で delete_git_merged_branch.sh"
  (cd "$root" && "$BIN_DIR/delete_git_merged_branch.sh") || echo "claude-task: warning: delete_git_merged_branch.sh が失敗しました" >&2
}

cmd_finish() {
  local id="$1" to="$2"; shift 2
  require_task "$id"
  local result="$*" type open
  type=$(task_field "$id" type)
  [ -n "$result" ] || result=$(task_field "$id" result)
  if [ "$to" = "done" ]; then
    case "$type" in
      analysis)
        [ -n "$result" ] || die "done: 分析は結論が必須です (claude-task done $id <問題なし|issue や Slack の URL>)" ;;
      epic)
        open=$(enriched_json | jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .kids_open | join(",")')
        [ -z "$open" ] || die "done: 未完了の子があります ($open)。終えるか drop してから done する" ;;
      work)
        if [ -z "$result" ] && [ "$(task_field "$id" 'prs | length')" = 0 ]; then
          echo "claude-task: warning: $id に prs も result もありません (PR 以外の成果物なら claude-task done $id <URL>)" >&2
        fi ;;
    esac
  fi
  lock
  update_task "$id" '.status = $v | .result = $r | .log += [{at: $now, msg: ($v + (if $r != "" then ": " + $r else "" end) + $tag)}]' \
    --arg v "$to" --arg r "$result" --arg tag "$(caller_tag)"
  rmdir "$LOCK_DIR" 2>/dev/null || true
  cleanup_merged "$id"
  local unblocked parent epic_done=""
  unblocked=$(next_json | jq -r --arg id "$id" '.[] | select(.blocked_by | index($id)) | "  \(.id) \(.title)"')
  parent=$(task_field "$id" parent)
  if [ -n "$parent" ]; then
    epic_done=$(enriched_json | jq -r --arg p "$parent" '.tasks[] | select(.id == $p and (.kids_open | length) == 0
      and .status != "done" and .status != "dropped") | "  \(.id) \(.title) (claude-task done \(.id))"')
  fi
  echo "$id -> $to"
  if [ -n "$unblocked" ]; then
    echo "起動可能になったタスク:"
    echo "$unblocked"
  fi
  if [ -n "$epic_done" ]; then
    echo "子がすべて終わった epic (done 候補):"
    echo "$epic_done"
  fi
}

# priority / type の表示ラベル (jq 定義。各 jq プログラムの先頭に連結して使う)
JQ_PRIO='def plabel: {"1": "1 復旧", "2": "2 優先", "3": "3 目標", "4": "4 その他"}[tostring] // ("P" + tostring);
def tlabel: {"analysis": "🔍 分析", "work": "🔧 作業", "request": "📨 依頼", "epic": "📦 epic"}[.] // .;'

# 端末での表示幅 (全角 = 2)。ls の桁揃えに使う。jq に wcwidth が無いため主要な全角範囲を判定する
JQ_WIDTH='
def dwidth: [explode[] | if (. >= 4352 and (. <= 4447 or (. >= 11904 and . <= 42191) or (. >= 44032 and . <= 55203)
  or (. >= 63744 and . <= 64255) or (. >= 65072 and . <= 65103) or (. >= 65280 and . <= 65376)
  or (. >= 65504 and . <= 65510) or (. >= 127744 and . <= 129791) or . >= 131072)) then 2 else 1 end] | add // 0;
def pad($w): (($w - dwidth) as $n | if $n > 0 then . + (" " * $n) else . end);
'

# 表示用の状態判定 (table / slack 共通)。state は [並び順, 状態ラベル, 補足]。補足はブロック先のタイトル
JQ_STATE='
def state($titles):
  ((.blocking | map("「" + ($titles[.] // .) + "」") | join("・")) + " 待ち") as $bl
  # running でも blocked_by が未完了なら補足に待ち先を出す (session が先に動いていても依存は残っている)
  | if .status == "running" then
    (if .live == "idle" or .live == "waiting" then [0, "返事待ち"]
     elif .live == "exited" or .live == "" then [1, "要確認 (session 終了)"]
     else [2, "実行中"] end) + [if (.blocking | length) > 0 then $bl else "" end]
  elif .status == "waiting" then [2.5, "依頼中", (if .waiting_on != "" then .waiting_on + " 待ち" else "相手待ち" end)]
  elif (.status == "queued" or .status == "inbox") and (.blocking | length) > 0 then [4, "ブロック中", $bl]
  # epic の「起動可能」は着手可ではなく、振り分け・進捗の親 session が未起動という意味なので分ける
  elif .type == "epic" and .status == "queued" then [3.2, "親 session 未起動", "/kidou \(.id | ltrimstr("T-")) で起動"]
  elif .status == "queued" and .priority == 4 then [3.5, "保留 (着手するなら目標へ格上げ)", ""]
  elif .status == "queued" then [3, "起動可能", ""]
  elif .status == "inbox" then [5, "inbox (dir 未定)", ""]
  elif .status == "done" then [6, "完了", ""]
  else [7, "取り下げ", ""] end;
def where: if .repo == "" then "" elif .group != "" and .group != .repo then " [" + .group + "/" + .repo + "]" else " [" + .repo + "]" end;
# epic は子の進捗、子は所属 epic を概要に添える
def rel($titles): if .type == "epic" then " (子 \((.kids | length) - (.kids_open | length))/\(.kids | length) 完了)"
  elif .parent != "" then " ⊂「" + ($titles[.parent] // .parent) + "」" else "" end;
'

# Slack 報告用 (mrkdwn)。Slack は Markdown 表を描画しないため箇条書きにする。
# 優先度ごとに見出しを切り、その中を概要 (summary = 機能) ごとの段落にする。段落の見出しは「お客さん名: 概要」
# (お客さん名は段落内のタスクの customer を「・」で分解・重複除去してから「・」で連ねる)。番号・session・状態は出さない (報告相手には意味がない)。
# 段落が 2 件以上のタスクを持つか、段落外のタスクを待つときだけ、タスク名を依存順に並べる
# (段落内で待っているタスクは最初の待ち先の下に「↳」で字下げ、2 件目以降の待ち先と段落外の待ち先は「(「…」の後)」を添える)。
# customer 空は「未確認」、summary 空は title。タスク外 session は出さない
slack_view() {
  jq -r "$JQ_PRIO"'
    def esc: tostring | gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;") | gsub("\n"; " ");
    def corder: if . == "全体" then 0 elif . == "未確認" then 2 else 1 end;
    (.tasks | map({key: .id, value: .title}) | from_entries) as $titles
    | (.tasks | map({key: .id, value: .}) | from_entries) as $byid
    # epic の子は epic 単位 (見出しは epic の summary、無ければ epic の title。お客さん名は epic のものを優先し、空なら子のもの)。
    # epic 自身は行に出さず、epic に属さないタスクは従来どおり summary 単位
    | [.tasks[] | select(.status != "done" and .status != "dropped" and .type != "epic")
      | ($byid[.parent] // null) as $e
      | {id, title, priority, created, blocking,
         customer: (if ($e.customer // "") != "" then $e.customer elif (.customer // "") != "" then .customer else "未確認" end),
         summary: (if $e then (if ($e.summary // "") != "" then $e.summary else $e.title end)
                   elif (.summary // "") == "" then .title else .summary end),
         key: (if $e then "E:" + $e.id elif (.summary // "") == "" then "S:" + .title else "S:" + .summary end)}] as $live
    | if ($live | length) == 0 then "(タスクなし)"
      else
        $live | group_by(.priority)[]
        | "*\(.[0].priority | plabel)*",
          (group_by(.key)
           # 「全体」だけの段落を先頭、「未確認」だけの段落を末尾、ほかは最初のタスクの作成順
           | sort_by((map(.customer | corder) | min), (map(.created) | min))[]
           | sort_by(.created) as $g
           | ($g | map(.id)) as $ids
           # 段落内の待ち先 (最初の 1 件) の下に置く。段落内に待ち先が無いものが根
           | def parent: [.blocking[] | select(. as $b | $ids | index($b))][0];
             # 字下げで表せない待ち先 (段落外、または段落内の 2 件目以降) は注記で出す
             def outer: parent as $p | [.blocking[] | select(. != $p) | "「" + (($titles[.] // .) | esc) + "」"];
             def line($depth): (if $depth == 0 then "• " else ("    " * $depth) + "↳ " end) + (.title | esc)
               + (outer as $o | if ($o | length) > 0 then " (" + ($o | join("・")) + " の後)" else "" end);
             def tree($depth): . as $t | line($depth), ($g[] | select(parent == $t.id) | tree($depth + 1));
             ($g | map(.customer | split("・")[] | select(. != "")) | unique | sort_by(corder, .) | map(esc) | join("・")) + ": *" + ($g[0].summary | esc) + "*",
             (if ($g | length) > 1 or ($g[0] | outer | length) > 0 then ($g[] | select(parent == null) | tree(0)) else empty end),
             ""
          )
      end'
}

# /kidou・/bankai の実行後にそのまま貼る Markdown 表 (タスク番号 / 優先度 / 種別 / session 名 / 概要 / 状態)。
# 並びはユーザーの対応が要る順 (返事待ち → 要確認 → 実行中 → 依頼中 → 起動可能 → epic の親 session 未起動 → 保留(優先度4) → ブロック中 → inbox → 完了/取り下げ)、
# 同じ状態内は priority → created。タスク外 session は ID "-" で末尾に出す
table_view() {
  jq -r "$JQ_PRIO$JQ_STATE"'
    def cell: tostring | gsub("\\|"; "\\|") | gsub("\n"; " ");
    (.tasks | map({key: .id, value: .title}) | from_entries) as $titles
    | ([.tasks[] | . + {st: state($titles)}] | sort_by(.st[0], .priority, .created)) as $rows
    | if ($rows | length) == 0 and (.untracked | length) == 0 then "(タスクなし)"
      else
        "| タスク | 優先度 | 種別 | session | 概要 | 状態 |",
        "|---|---|---|---|---|---|",
        ($rows[] | "| \(.id) | \(.priority | plabel) | \(.type | tlabel) | \(if .session_name != "" then .session_name else "-" end | cell) | \((.title + where + rel($titles)) | cell) | \(.st[1])\(if .st[2] != "" then " (" + .st[2] + ")" else "" end | cell) |"),
        (.untracked[] | "| - | - | - | \(if .name != "" then .name else .sessionId[0:8] end | cell) | (タスク外)\(where | cell) | \(if .status == "idle" or .status == "waiting" then "返事待ち" else "実行中" end) |")
      end'
}

# epic の依存ツリー。子 (done / dropped を含む) を、epic 内の最初の待ち先の下に字下げして並べる
# (slack の段落と同じ規則。2 件目以降の待ち先と epic 外の待ち先は「(「…」の後)」)。epic 省略時は未完了の全 epic
cmd_tree() {
  local target="${1:-}"
  if [ -n "$target" ]; then
    require_task "$target"
    [ "$(task_field "$target" type)" = epic ] || die "tree: $target は epic ではありません"
  fi
  enriched_json | jq -r --arg target "$target" "$JQ_PRIO$JQ_STATE"'
    (.tasks | map({key: .id, value: .title}) | from_entries) as $titles
    | .tasks as $all
    | [$all[] | select(.type == "epic" and (if $target != "" then .id == $target else (.status != "done" and .status != "dropped") end))]
    | if length == 0 then "(epic なし)" else .[] |
        . as $e
        | ([$all[] | select(.parent == $e.id)] | sort_by(.created)) as $g
        | ($g | map(.id)) as $ids
        | def parent: [.blocked_by[] | select(. as $b | $ids | index($b))][0];
          def outer: parent as $p | [.blocked_by[] | select(. != $p) | "「" + ($titles[.] // .) + "」"];
          def line($depth): (if $depth == 0 then "  • " else "  " + ("    " * $depth) + "↳ " end)
            + "\(.id) \(.type | tlabel) \(.title)" + (outer as $o | if ($o | length) > 0 then " (" + ($o | join("・")) + " の後)" else "" end)
            + " — " + (state($titles) | .[1] + (if .[2] != "" and .[1] != "ブロック中" then " (" + .[2] + ")" else "" end));
          def tree($depth): . as $t | line($depth), ($g[] | select(parent == $t.id) | tree($depth + 1));
          "\($e.id) \($e.type | tlabel) \($e.title)\($e | rel($titles)) — \($e | state($titles) | .[1])",
          (if ($g | length) == 0 then "  (子なし: /kidou parent: \($e.id) <依頼文> で積む)" else ($g[] | select(parent == null) | tree(0)) end),
          ""
      end'
}

cmd_ls() {
  local all="" json="" table="" slack=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      --json) json=1; shift ;;
      --table) table=1; shift ;;
      --slack) slack=1; shift ;;
      *) die "ls: 不明な引数 $1" ;;
    esac
  done
  local e
  e=$(enriched_json | jq --arg all "$all" '
    .tasks |= map(select($all == "1" or (.status != "done" and .status != "dropped")))')
  if [ -n "$json" ]; then echo "$e"; return; fi
  if [ -n "$table" ]; then table_view <<<"$e"; return; fi
  if [ -n "$slack" ]; then slack_view <<<"$e"; return; fi

  jq -r "$JQ_PRIO$JQ_WIDTH$JQ_STATE"'
    (.tasks | map({key: .id, value: .title}) | from_entries) as $titles
    # 1 行 = [タスク, 優先度, 種別, session, 概要, 補足]。補足 (ブロック先 / 依頼先) は最終列なので揃えない
    | def row: [.id, (.priority | plabel), (.type | tlabel), (if .session_name != "" then .session_name else "-" end),
                (.title + where + rel($titles)),
                (if (.blocking | length) > 0 then "⛔ " + (.blocking | map("「" + ($titles[.] // .) + "」") | join("・")) + " 待ち"
                 elif .status == "waiting" and .waiting_on != "" then "📨 " + .waiting_on + " 待ち" else "" end)];
      def urow: ["-", "-", "-", (if .name != "" then .name else .sessionId[0:8] end), ("(タスク外)" + where), .status];
    .tasks as $t
    | [
        ["返事待ち (idle/waiting)", ([$t[] | select(.status == "running" and (.live == "idle" or .live == "waiting"))] | sort_by(.priority, .created) | map(row))],
        ["実行中 (busy)", ([$t[] | select(.status == "running" and ([.live] | inside(["idle", "waiting", "exited", ""]) | not))] | sort_by(.priority, .created) | map(row))],
        ["要確認 (session 終了済み / 未紐付けの running)", ([$t[] | select(.status == "running" and (.live == "exited" or .live == ""))] | map(row))],
        ["依頼中 (相手待ち)", ([$t[] | select(.status == "waiting")] | sort_by(.priority, .created) | map(row))],
        ["起動可能", ([$t[] | select(.status == "queued" and .type != "epic" and .priority < 4 and (.blocking | length) == 0)] | sort_by(.priority, .created) | map(row))],
        ["epic (親 session 未起動。/kidou <n> で振り分け・進捗の親 session を起動)", ([$t[] | select(.status == "queued" and .type == "epic" and (.blocking | length) == 0)] | sort_by(.priority, .created) | map(row))],
        ["保留 (4 その他。着手するなら目標へ格上げ)", ([$t[] | select(.status == "queued" and .type != "epic" and .priority == 4 and (.blocking | length) == 0)] | sort_by(.created) | map(row))],
        ["ブロック中", ([$t[] | select((.status == "queued" or .status == "inbox") and (.blocking | length) > 0)] | sort_by(.priority, .created) | map(row))],
        ["inbox (dir 未定)", ([$t[] | select(.status == "inbox" and (.blocking | length) == 0)] | sort_by(.priority, .created) | map(row))],
        ["完了", ([$t[] | select(.status == "done")] | map(row))],
        ["取り下げ", ([$t[] | select(.status == "dropped")] | map(row))],
        ["タスク外 session — claude-task adopt <name> で取り込み", ([.untracked[] | urow])]
      ]
    | map(select((.[1] | length) > 0)) as $sections
    # 全セクション共通の列幅 (先頭 5 列。見出し行も含める)
    | ([["タスク", "優先度", "種別", "session", "概要"]] + [$sections[] | .[1][]]) as $all
    | [range(0; 5) as $i | [$all[] | .[$i] | dwidth] | max] as $w
    | def fmt: [range(0; 5) as $i | .[$i] | pad($w[$i])] + [.[5]] | join("  ") | sub("\\s+$"; "");
      if ($sections | length) == 0 then "(タスクなし)"
      else
        $sections[]
        | "■ \(.[0]) (\(.[1] | length))",
          ("  " + (["タスク", "優先度", "種別", "session", "概要", ""] | fmt)),
          (.[1][] | "  " + fmt),
          ""
      end
  ' <<<"$e"
}

main() {
  local cmd="${1:-ls}"
  shift || true
  case "$cmd" in
    add) cmd_add "$@" ;;
    ls) cmd_ls "$@" ;;
    show) require_task "${1:-}"; jq . "$(task_file "$1")" ;;
    set) cmd_set "${1:-}" "${@:2}" ;;
    log) cmd_log "${1:-}" "${@:2}" ;;
    link) cmd_link "${1:-}" "${2:-}" "${3:-}" ;;
    adopt) cmd_adopt "$@" ;;
    done) cmd_finish "${1:-}" "done" "${@:2}" ;;
    drop) cmd_finish "${1:-}" dropped "${@:2}" ;;
    tree) cmd_tree "${1:-}" ;;
    brief) cmd_brief "${1:-}" ;;
    id-of-session) cmd_id_of_session "${1:-}" ;;
    launch-spec) cmd_launch_spec "${1:-}" ;;
    -h|--help|help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "不明なサブコマンド: $cmd (help を参照)" ;;
  esac
}

main "$@"
