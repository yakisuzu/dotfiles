if [[ "$IS_INTERACTIVE" == "true" ]]; then
  echo ------------------
  echo read .bashrc_local
  echo ------------------
fi

# mise
# global ver は dotfiles 外 (~/.config/mise/config.toml) で管理
#mise use -g java@corretto-21
#mise use -g node@24
#mise use -g python@3.11
# 非interactive は shims のみで環境変数が設定されないため、global ver に合わせて固定
MISE_INSTALLS="${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs"
[[ "$IS_INTERACTIVE" != "true" ]] && export JAVA_HOME="$MISE_INSTALLS/java/corretto-21"

# PATH
## mysql
#export PATH="$PATH:$BREW_PREFIX/opt/mysql-client@8.0/bin"

## AWS@1
